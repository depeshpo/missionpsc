# Supabase — copy to .env.local and fill from your Supabase project
# (Project Settings → API). .env.local is gitignored.

# Project URL and public anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_URL=https://<projectID>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=public-supabase-anon-ky

# Service-role key — SERVER ONLY. Never commit; never expose to the browser.
# Used by the seed script (scripts/seed.ts) and admin user onboarding.
SUPABASE_SERVICE_ROLE_KEY=supabase-service-role-key